{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/icons/**",
              "components/site/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Serif|DM Sans|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Noto Serif, DM Sans, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowRight'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|style|className|key|ref|className|style|children)$/]",
        "message": "<ArrowRight> doesn't accept that prop. Declared props: size, color, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowUpRight'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|style|className|key|ref|className|style|children)$/]",
        "message": "<ArrowUpRight> doesn't accept that prop. Declared props: size, color, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Experience'] > JSXAttribute > JSXIdentifier[name!=/^(?:period|title|description|style|key|ref|className|style|children)$/]",
        "message": "<Experience> doesn't accept that prop. Declared props: period, title, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|active|style|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: children, href, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Profile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|href|style|key|ref|className|style|children)$/]",
        "message": "<Profile> doesn't accept that prop. Declared props: name, image, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|subtitle|weight|style|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: children, subtitle, weight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|arrow|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, arrow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|href|imageHeight|style|key|ref|className|style|children)$/]",
        "message": "<WorkItem> doesn't accept that prop. Declared props: image, eyebrow, title, href, imageHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Writting'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|title|href|style|key|ref|className|style|children)$/]",
        "message": "<Writting> doesn't accept that prop. Declared props: year, title, href, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
