# Client-side analytics identifiers. These are public (they ship in the browser
# bundle) but are read from the environment so they aren't hardcoded in source.
# Copy this file to .env.local and fill in the values, and set the same vars in
# the Vercel project (Settings → Environment Variables).
NEXT_PUBLIC_AMPLITUDE_API_KEY=
NEXT_PUBLIC_SMARTLOOK_KEY=
NEXT_PUBLIC_GA_ID=

# PostHog. The host is the region you signed up in (US: https://us.i.posthog.com,
# EU: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
